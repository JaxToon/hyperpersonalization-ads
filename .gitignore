# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.env

# Kaggle "Santander Product Recommendation" competition data — not
# redistributed here (competition terms restrict redistribution, and the
# raw CSV alone is ~2.2GB). Download via Kaggle and place under dataset/,
# then run scripts/build_features.py to regenerate everything below.
dataset/

# Regenerated by scripts/build_features.py
data/*.parquet
data/events.jsonl

# Regenerated by scripts/run_training.py — the model binary is ~40MB and
# fully reproducible from data/train_exploded.parquet, so it isn't tracked.
artifacts/*.txt
artifacts/baseline_v1/*.txt

# Local env overrides
.env.local

# Local Claude Code tooling state
.claude/
