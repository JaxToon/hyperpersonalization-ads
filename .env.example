# Copy to .env and adjust. src/serve.py reads these from the process
# environment (not auto-loaded from .env — export them or use your shell/
# process manager of choice before running uvicorn).

# Auth key required in the X-API-Key header for /v1/ad/serve and /v1/event/feedback.
AD_ENGINE_API_KEY=change-me-to-a-real-secret

# Force the in-process fakeredis fallback even if a real Redis is reachable
# (useful for isolated local runs). 1/true/yes to enable.
AD_ENGINE_USE_FAKE_REDIS=0

# Optional: only used by src/creative_engine.py's LLM fallback path for
# personas outside the curated creative-template grid. Leave unset to use
# the deterministic template fallback instead (no external calls made).
ANTHROPIC_API_KEY=
